// ═══════════════════════════════════════════════════════════════════════
//  lumax / 后端 — 独立流水线
//
//  Jenkins 建 job 时（类型选「流水线」）Script Path 填：server/Jenkinsfile
//  （Jenkins 把整个仓库 checkout 到工作区根，下面路径都从仓库根算起）
//
//  数据库迁移单独用参数控制，默认不执行 —— 这个项目用的是有序 SQL 脚本
//  而不是迁移框架，没有「已执行」记录表，不能挂在每次部署上。详见下面
//  RUN_MIGRATIONS 的说明。
// ═══════════════════════════════════════════════════════════════════════

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  // ── 触发方式 ──────────────────────────────────────────────────────
  //  构建哪个分支由 job 配置里的 Branch Specifier 决定（填 */main），
  //  下面的阶段不再判断分支 —— 也就是说改那个字段就等于改部署目标，
  //  别随手改成 */develop，那会把开发分支的代码发到生产。
  triggers {
    // GitHub webhook 推送即触发。
    // job 配置里也要勾上 "GitHub hook trigger for GITScm polling"，
    // 两者配合才生效。
    githubPush()
    // 兜底：每 4 小时轮询一次，防止 webhook 偶尔丢失（网络抖动、
    // GitHub 侧重试失败）。不需要可以删掉这行。
    pollSCM('H H/4 * * *')
  }
  parameters {
    booleanParam(
      name: 'FORCE_REBUILD',
      defaultValue: false,
      description: '忽略变更检测，强制重新打包镜像。注意：只是改了 server.env 的话不用勾这个，勾 REDEPLOY 就够了。'
    )
    booleanParam(
      name: 'REDEPLOY',
      defaultValue: false,
      description: '不重新打包，只用当前镜像重新部署一次，让容器加载新的 server.env。改了数据库密码、AUTH_MOCK、SCHEDULER_ENABLED 之后用这个。'
    )
    booleanParam(
      name: 'RUN_MIGRATIONS',
      defaultValue: false,
      description: '''执行数据库迁移（database/scripts/V001…V013）。
⚠️ 默认关闭，只在首次部署或明确新增了迁移脚本时才勾。
这个项目没有迁移记录表，apply-migrations.mjs 每次都从头重放全部脚本，
其中 V003/V011/V012 是 demo 数据的 INSERT —— 重复执行会主键冲突或造出
重复数据。要续跑请配合下面的 MIGRATION_START_FROM。'''
    )
    string(
      name: 'MIGRATION_START_FROM',
      defaultValue: '',
      description: '从指定脚本开始执行迁移，例如填 V007 就只跑 V007 及之后的。留空 = 从 V001 全量重放。'
    )
    booleanParam(
      name: 'NO_CACHE',
      defaultValue: false,
      description: '禁用 Docker 层缓存。只在怀疑缓存脏了时用。'
    )
  }

  environment {
    IMAGE        = 'lumax-server'
    CONTAINER    = 'lumax-server'
    SERVICE      = 'server'
    COMPOSE_FILE = 'server/docker-compose.yml'
    APP_ENV_FILE = '/opt/portfolio/lumax/server.env'
    BUILD_TAG_   = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'nogit'}"
    DOCKER_BUILDKIT = '1'
  }

  stages {

    stage('环境自检') {
      steps {
        sh '''
          set -e
          echo ">>> Docker  $(docker --version)"
          echo ">>> Compose $(docker compose version --short)"

          if [ ! -f "${APP_ENV_FILE}" ]; then
            echo "✗ 找不到 ${APP_ENV_FILE}"
            echo "  服务器还没初始化，见 _infra/README.md 的「首次部署」章节"
            exit 1
          fi

          # 校验 env 文件格式。Docker 的 env_file 解析器只认三种行：
          # 注释（# 开头）、空行、KEY=VALUE。多出任何别的形式 —— 比如
          # 编辑时在行首误加了一个字符 —— 会等到 compose up 阶段才报
          # "invalid environment variable"，而且不告诉你是哪个文件的哪一行。
          # 在这里拦住并直接指出行号，省掉一轮排查。
          bad_lines=$(awk '!/^[[:space:]]*#/ && !/^[[:space:]]*$/ && !/^[A-Za-z_][A-Za-z0-9_]*=/ { print "    行"NR": "$0 }' "${APP_ENV_FILE}")
          if [ -n "$bad_lines" ]; then
            echo "✗ ${APP_ENV_FILE} 里有 env_file 无法解析的行："
            echo "$bad_lines"
            echo "  只接受：# 注释 / 空行 / KEY=VALUE"
            exit 1
          fi
          docker network inspect portfolio-net >/dev/null 2>&1 \\
            || { echo "✗ Docker 网络 portfolio-net 不存在，见 _infra/README.md"; exit 1; }

          # 两个都是硬依赖：Prisma 连不上库整个网关就是空壳，
          # Redis 挂了配额限流器会直接抛错
          for c in portfolio-postgres portfolio-redis; do
            docker ps --filter "name=$c" --filter "status=running" --format '{{.Names}}' \\
              | grep -q "$c" || { echo "✗ ${c} 未运行，lumax 后端强依赖它"; exit 1; }
          done
        '''
        script {
          env.PREV_IMAGE = sh(
            script: "docker inspect -f '{{.Config.Image}}' ${env.CONTAINER} 2>/dev/null || true",
            returnStdout: true).trim()
          echo "当前在跑的镜像：${env.PREV_IMAGE ?: '(无)'}"
        }
      }
    }

    stage('变更分析') {
      steps {
        script {
          def watchPaths = ['server/']
          def depFiles   = ['server/package.json', 'server/pnpm-lock.yaml']
          def infraFiles = ['server/Dockerfile', 'server/docker-compose.yml',
                            'server/Jenkinsfile', 'server/.dockerignore']

          def previous = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
          def changed = null

          if (params.FORCE_REBUILD) {
            echo '已勾选 FORCE_REBUILD → 强制重新打包'
          } else if (!previous) {
            echo '没有「上次成功构建」记录（首次构建或历史被清理）→ 全量打包'
          } else {
            def diff = sh(
              script: "git diff --name-only ${previous} ${env.GIT_COMMIT} 2>/dev/null || true",
              returnStdout: true).trim()
            if (diff) {
              changed = diff.split('\n').collect { it.trim() }.findAll { it }
            } else {
              echo '拿不到有效 diff（可能 force push 过）→ 全量打包'
            }
          }

          boolean srcChanged = false
          boolean depChanged = false
          boolean prismaChanged = false
          boolean migrationChanged = false
          int srcCount = 0
          def changedDepFiles = []

          if (changed == null) {
            srcChanged = true
            depChanged = true
          } else {
            def mine = changed.findAll { p -> watchPaths.any { w -> p.startsWith(w) } }

            changedDepFiles = mine.findAll { it in depFiles }
            depChanged = !changedDepFiles.isEmpty()

            prismaChanged    = mine.any { it.startsWith('server/prisma/') }
            migrationChanged = mine.any { it.startsWith('server/database/scripts/') }

            def srcFiles = mine.findAll { p ->
              !(p in depFiles) && !(p ==~ /(?i).*\.(md|txt)$/)
            }
            srcCount = srcFiles.size()
            srcChanged = srcCount > 0

            if (mine.any { it in infraFiles }) {
              echo '构建/编排文件有变更 → 强制重新打包'
              srcChanged = true
            }
          }

          boolean needBuild = srcChanged || depChanged

          if (!needBuild && !env.PREV_IMAGE) {
            echo '本地没有可复用的旧镜像 → 强制打包'
            needBuild = true
            srcChanged = true
          }

          boolean needDeploy = needBuild || params.REDEPLOY

          if (!needBuild && needDeploy) {
            def prev = env.PREV_IMAGE
            if (!prev) {
              error 'REDEPLOY 需要一个已存在的镜像，但当前没有容器在跑'
            }
            env.DEPLOY_TAG = prev.contains(':') ? prev.substring(prev.lastIndexOf(':') + 1) : 'latest'
            echo "只重新部署，沿用镜像 tag：${env.DEPLOY_TAG}"
          } else {
            env.DEPLOY_TAG = env.BUILD_TAG_
          }

          env.NEED_BUILD   = needBuild.toString()
          env.NEED_DEPLOY  = needDeploy.toString()
          env.DEPS_CHANGED = depChanged.toString()

          // ── 打包决策表 ──────────────────────────────────────────
          String basis = previous ? "${previous.take(7)}（上次成功构建）" : '无（首次构建）'
          String srcLine = srcChanged ? "是   ${srcCount} 个文件" : '否'
          if (prismaChanged) {
            srcLine += '\n                    含 prisma/ → 镜像构建时会重新 generate 客户端'
          }
          String depLine
          if (depChanged) {
            depLine = "是   ${changedDepFiles.join(', ')}\n                    → install 层缓存失效，本次会重跑 pnpm install"
          } else {
            depLine = '否   → install 层命中缓存，完全跳过依赖安装'
          }
          String verdict
          if (needBuild) {
            verdict = "重新打包镜像并部署（tag=${env.DEPLOY_TAG}）"
          } else if (needDeploy) {
            verdict = "只重新部署，不打包（沿用 ${env.DEPLOY_TAG}）"
          } else {
            verdict = '跳过 —— 本模块无变更'
          }

          echo """
────────────────────────────────────────────────────────────────
  打包决策 · lumax / server
────────────────────────────────────────────────────────────────
  比较基点      ${basis}
  本次提交      ${env.GIT_COMMIT?.take(7) ?: '-'}

  源码变更      ${srcLine}
  依赖变更      ${depLine}

  结论          ${verdict}
────────────────────────────────────────────────────────────────
"""

          if (migrationChanged && !params.RUN_MIGRATIONS) {
            echo '''
⚠ 检测到 database/scripts/ 下的迁移脚本有变更，但本次不会自动执行迁移。
  如需应用，请重跑本流水线并勾选 RUN_MIGRATIONS，同时用
  MIGRATION_START_FROM 指定起始脚本，以免重放已经执行过的部分。
'''
          }

          if (needBuild) {
            currentBuild.description = "打包 ${env.DEPLOY_TAG}"
          } else if (needDeploy) {
            currentBuild.description = "仅重部署 ${env.DEPLOY_TAG}"
          } else {
            currentBuild.description = '无变更，已跳过'
          }
        }
      }
    }

    stage('打包镜像') {
      when { environment name: 'NEED_BUILD', value: 'true' }
      steps {
        script {
          if (env.DEPS_CHANGED == 'true') {
            echo '依赖清单有变更：pnpm install 会重跑，但 pnpm store 挂了 cache mount，已下载过的包会直接复用'
          }
          withEnv(["IMAGE_TAG=${env.DEPLOY_TAG}"]) {
            sh """
              set -e
              docker compose \\
                --env-file '${env.APP_ENV_FILE}' \\
                -f '${env.COMPOSE_FILE}' \\
                build ${params.NO_CACHE ? '--no-cache' : ''} ${env.SERVICE}
            """
          }
        }
      }
    }

    stage('数据库迁移') {
      when { expression { params.RUN_MIGRATIONS } }
      steps {
        script {
          def startFrom = params.MIGRATION_START_FROM?.trim()

          // 用哪个镜像跑迁移：本次打包了就用新镜像，没打包就用正在跑的那个
          String imageRef
          if (env.NEED_BUILD == 'true') {
            imageRef = "${env.IMAGE}:${env.DEPLOY_TAG}"
          } else {
            imageRef = env.PREV_IMAGE ?: "${env.IMAGE}:latest"
          }

          if (startFrom) {
            echo "从 ${startFrom} 开始执行迁移"
          } else {
            echo '⚠ 从 V001 全量重放迁移（若库里已有数据，demo 数据脚本可能冲突）'
          }

          // 用一次性容器跑迁移，而不是 docker exec 进长驻容器：首次部署时
          // 长驻容器还不存在，而镜像里已经带了 database/ 和 scripts/，
          // 一次性容器随时可跑，跑完即销毁。
          sh """
            set -e
            docker run --rm \\
              --network portfolio-net \\
              --env-file '${env.APP_ENV_FILE}' \\
              '${imageRef}' \\
              node scripts/apply-migrations.mjs ${startFrom ?: ''}
          """
        }
      }
    }

    stage('部署') {
      when { environment name: 'NEED_DEPLOY', value: 'true' }
      steps {
        withEnv(["IMAGE_TAG=${env.DEPLOY_TAG}"]) {
          sh '''
            set -e
            echo ">>> 滚动更新（tag=${IMAGE_TAG}）"
            docker compose --env-file "${APP_ENV_FILE}" -f "${COMPOSE_FILE}" up -d
            docker compose --env-file "${APP_ENV_FILE}" -f "${COMPOSE_FILE}" ps
          '''
        }
      }
    }

    stage('健康检查') {
      when { environment name: 'NEED_DEPLOY', value: 'true' }
      steps {
        script {
          int rc = sh(returnStatus: true, script: '''
            deadline=$(( $(date +%s) + 180 ))
            state=unknown
            while [ "$(date +%s)" -lt "$deadline" ]; do
              state=$(docker inspect -f '{{.State.Health.Status}}' "${CONTAINER}" 2>/dev/null || echo missing)
              if [ "$state" = "healthy" ]; then
                echo "✓ ${CONTAINER} healthy"
                exit 0
              fi
              echo "等待 ${CONTAINER}($state)"
              sleep 5
            done
            echo "✗ 健康检查超时，最后状态: $state"
            exit 1
          ''')
          if (rc != 0) {
            echo '── 容器日志 ──────────────────────────────────────'
            sh 'docker logs --tail 120 "${CONTAINER}" 2>&1 || true'
            error '健康检查未通过'
          }

          // /api/health/ready 会真正探一次 DB 和 Redis 的可达性，
          // 容器 healthy 只代表 HTTP 端口活着
          sh '''
            set +e
            echo ">>> /api/health/ready 详情"
            docker exec "${CONTAINER}" node -e "
              fetch('http://127.0.0.1:' + (process.env.PORT || 9008) + '/api/health/ready')
                .then(r => r.text()).then(t => console.log(t))
                .catch(e => console.error('探测失败:', e.message))
            "
          '''
        }
      }
    }
  }

  post {
    failure {
      script {
        boolean deployed = env.NEED_DEPLOY == 'true'
        if (deployed && env.PREV_IMAGE) {
          echo '── 回滚到上一版镜像 ───────────────────────────────'
          withEnv(['IMAGE_TAG=rollback']) {
            sh """
              set +e
              docker tag '${env.PREV_IMAGE}' '${env.IMAGE}:rollback'
              docker compose --env-file '${env.APP_ENV_FILE}' -f '${env.COMPOSE_FILE}' up -d
              docker compose --env-file '${env.APP_ENV_FILE}' -f '${env.COMPOSE_FILE}' ps
            """
          }
          echo "已回滚。失败版本 ${env.DEPLOY_TAG} 的镜像仍保留，可本地复现排查。"
        } else if (deployed) {
          echo '没有可回滚的上一版镜像（首次部署失败），请看上面的容器日志。'
        }
      }
    }
    success {
      script {
        if (env.NEED_BUILD == 'true') {
          sh '''
            set +e
            docker images "${IMAGE}" --format '{{.Tag}}' \
              | grep -E '^[0-9]+-' | sort -t- -k1,1 -n -r | tail -n +4 \
              | while read -r tag; do
                  echo "清理旧镜像 ${IMAGE}:${tag}"
                  docker rmi "${IMAGE}:${tag}" >/dev/null 2>&1
                done
            docker image prune -f >/dev/null 2>&1
          '''
        }
      }
    }
    always {
      sh 'docker builder prune -f --filter until=168h >/dev/null 2>&1 || true'
    }
  }
}
