{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install && pnpm prisma generate",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
