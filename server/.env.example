# ── Lumax Service (NestJS API Gateway) ─────────────────────────────
# Copy to `.env` (or `.env.development` / `.env.production`) and fill in.

# HTTP port
PORT=9008

# PostgreSQL (Prisma + @prisma/adapter-pg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumax?schema=public
# Force TLS for managed Postgres if the URL has no sslmode and the host isn't
# auto-detected (Neon/Supabase/Aiven/RDS are detected automatically).
DATABASE_SSL=false

# Redis (ioredis) — powers atomic quota limiter + caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Force TLS for managed Redis (Upstash/Redis Cloud are auto-detected by host).
REDIS_TLS=false

# Upstream API gateway proxied by JavaProxyMiddleware
JAVA_GATEWAY_URL=http://localhost:8080/api

# DeerFlow / agent backend (optional)
LUMAX_BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=debug

# Swagger / OpenAPI docs at /api-docs
SWAGGER_ENABLED=true

# CORS allowlist (comma-separated origins). Empty = allow all (handy when the
# SPA and API are on different Vercel domains). Set to your frontend URL(s) in
# production, e.g. https://lumax-web.vercel.app
CORS_ORIGINS=

# Cron jobs (hourly/daily/monthly aggregation, cleanup, quota alerts).
# Requires a long-running process — set true on Railway/Render/VM/Docker.
# Leave false/unset on serverless (Vercel): timers can't fire there anyway.
SCHEDULER_ENABLED=false

# Dev-only: skip Redis opaque-token check and inject a mock user
AUTH_MOCK=true

# ── Nacos service discovery (optional, disable for local demo) ──────
NACOS_ENABLED=false
NACOS_SERVER_LIST=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_SERVICE_NAME=lumax-service
NACOS_GROUP_NAME=DEFAULT_GROUP

# ── Apifox OpenAPI sync (optional) ──────────────────────────────────
APIFOX_PROJECT_ID=
APIFOX_API_KEY=
