# ── Lumax Service (NestJS API Gateway) ─────────────────────────────
# Copy to `.env` (or `.env.development` / `.env.production`) and fill in.

# HTTP port
PORT=9008

# PostgreSQL (Prisma + @prisma/adapter-pg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumax?schema=public

# Redis (ioredis) — powers atomic quota limiter + caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Upstream API gateway proxied by JavaProxyMiddleware
JAVA_GATEWAY_URL=http://localhost:8080/api

# DeerFlow / agent backend (optional)
LUMAX_BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=debug

# Swagger / OpenAPI docs at /api-docs
SWAGGER_ENABLED=true

# Dev-only: skip Redis opaque-token check and inject a mock user
AUTH_MOCK=true

# ── Nacos service discovery (optional, disable for local demo) ──────
NACOS_ENABLED=false
NACOS_SERVER_LIST=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_SERVICE_NAME=lumax-service
NACOS_GROUP_NAME=DEFAULT_GROUP

# ── Apifox OpenAPI sync (optional) ──────────────────────────────────
APIFOX_PROJECT_ID=
APIFOX_API_KEY=
