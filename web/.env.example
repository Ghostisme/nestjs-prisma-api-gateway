# ── Lumax Agent (React 19 + Vite) ──────────────────────────────────
# Copy to `.env.development` / `.env.production` and adjust.
#
# ⚠️ Deploying to Vercel: there is NO Vite dev proxy in production, so the app
# must call the backend by its ABSOLUTE URL. Set these in the Vercel project's
# Environment Variables (not committed here):
#     VITE_APP_API_BASE_URL = https://<your-server>.vercel.app/api
#     VITE_LUMAX_BFF_URL     = https://<your-server>.vercel.app
# Everything the app calls (API + the /health/ready wakeup probe) derives from
# VITE_APP_API_BASE_URL, so that one value is what points the SPA at the gateway.

# App title shown in the browser tab
VITE_APP_TITLE=Lumax

# Default route after login
VITE_APP_DEFAULT_ROUTE=/ai-dashboard/user-dashboard

# Public base path & router mode
VITE_APP_PUBLIC_PATH=/
VITE_APP_ROUTER_MODE=frontend

# API base (frontend calls the NestJS gateway via this prefix)
VITE_APP_API_BASE_URL=/api

# Backend / gateway URL used by the Vite dev proxy
VITE_API_BASE_URL=http://localhost:9008/api

# Business code header sent with each request
VITE_API_BASE_BUSINESS_CODE=ai

# Lumax BFF (NestJS service) URL
VITE_LUMAX_BFF_URL=http://localhost:9008

# Dev toggles
VITE_USE_MOCK_AUTH=false
VITE_ENABLE_PERMISSION_CHECK=false

# Cold-start wakeup gate: shows a "waking up database" overlay on the first
# request to an idle serverless backend. Set to "false" to disable entirely.
# (Warm backends never see the overlay, so leaving it on is safe for local dev.)
VITE_ENABLE_WAKEUP_GATE=true
