# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare source code files to use LF
*.ts eol=lf
*.tsx eol=lf
*.js eol=lf
*.jsx eol=lf
*.json eol=lf
*.css eol=lf
*.scss eol=lf
*.less eol=lf
*.html eol=lf
*.xml eol=lf
*.md eol=lf
*.yml eol=lf
*.yaml eol=lf

# Batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts use LF
*.sh text eol=lf

# Windows scripts use CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
